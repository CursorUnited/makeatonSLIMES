# Copy to .env and fill in. Values below are LOCAL TEST VALUES ONLY.

# Local PostgreSQL 18
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/slimes
DATABASE_URL_TEST=postgresql://postgres:<password>@localhost:5432/slimes_test

# At least 32 random characters, never committed
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_HOURS=8

PORT=4000
TZ=Asia/Kolkata
APP_URL=http://localhost:5173

# Optional real SMTP; empty = emails go to the Outbox table only
SMTP_URL=

BILLING_AUTO_CONFIRM=false
BILLING_CRON=5 0 * * *
RESET_TOKEN_TTL_MIN=30
PAGE_SIZE_MAX=100

COMPANY_NAME=Brightloop Software
COMPANY_ADDRESS=Lucknow, Uttar Pradesh
COMPANY_EMAIL=billing@brightloop.test
COMPANY_GSTIN=09ABCDE1234F1Z5

# Seed accounts (npm run db:seed) - local test values only
SEED_ADMIN_EMAIL=admin@brightloop.test
SEED_ADMIN_PASSWORD=Admin@1234
SEED_STAFF_EMAIL=staff@brightloop.test
SEED_STAFF_PASSWORD=Staff@1234
SEED_CUSTOMER_EMAIL=customer@brightloop.test
SEED_CUSTOMER_PASSWORD=Customer@1234
